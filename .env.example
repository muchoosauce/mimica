# Active provider used by image generation and the prompt-writing LLM.
# Either "muapi" or "kie".
ACTIVE_PROVIDER=muapi

# MuAPI key — required when ACTIVE_PROVIDER=muapi.
MUAPI_KEY=your_muapi_key_here

# Kie.ai key — required when ACTIVE_PROVIDER=kie.
KIE_API_KEY=your_kie_key_here

# Anthropic API key — required by the Brand DNA Generator only.
# Independent of the active image provider above.
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: override the output directory for runs and Brand DNA results.
# OUTPUT_DIR=/Users/you/ad-variator-outputs
